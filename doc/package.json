{
  "name": "zudo-led-block-doc",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "zudo-circuit-doc generate --config ../circuit.config.ts && run-parallel dev:zfb dev:history dev:circuit",
    "build": "zfb build",
    "preview": "zfb preview",
    "check": "zfb check",
    "check:links": "node scripts/check-links.js",
    "dev:zfb": "zfb dev",
    "dev:zfb:network": "zfb dev --host 0.0.0.0",
    "dev:network": "run-parallel dev:zfb:network dev:history",
    "dev:history": "doc-history-server --port 4322 --content-dir src/content/docs",
    "dev:circuit": "zudo-circuit-doc generate --watch --config ../circuit.config.ts"
  },
  "dependencies": {
    "@takazudo/zfb": "5.2.2",
    "@takazudo/zfb-md-wasm": "5.2.2",
    "@takazudo/zfb-runtime": "5.2.2",
    "@takazudo/zudo-circuit-doc": "0.3.0",
    "@takazudo/zudo-doc": "9.1.3",
    "@takazudo/zudo-doc-history-server": "9.1.3",
    "diff": "^8.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "cf": "1.0.0-beta.28",
    "typescript": "^5.9.0",
    "wrangler": "4.158.0"
  }
}
